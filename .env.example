# Job Apply Pilot environment configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini (default model: gemini-3.8-flash)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override the model for every task
# Tasks run on tiers: fast (extract), standard (score, judge, interview) and
# quality (tailor, cover, answers, writing, career). Override a tier or one task
# with a comma-separated fallback chain; `applypilot doctor` shows the result.
# LLM_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# LLM_MODEL_QUALITY=gemini-4-argon,gemini-3.8-flash   # gemini-4-argon has no free tier
# LLM_MODEL_SCORE=

# Auto-Apply uses short re-observation plus applicant takeover for visible CAPTCHAs.
# Legacy CAPSOLVER_API_KEY values are ignored; Job Apply Pilot does not call solvers or inject tokens.

# Optional anti-detection browser backend (edge, cloak, or auto)
# APPLYPILOT_BROWSER_BACKEND=edge
# APPLYPILOT_CLOAK_VERSION=146.0.7680.177.5
# CLOAKBROWSER_AUTO_UPDATE=false
# CLOAKBROWSER_LICENSE_KEY=  # Keep only in the local Job Apply Pilot .env; never commit

# JobSpy/Workday proxies use the top-level proxy setting in searches.yaml.
